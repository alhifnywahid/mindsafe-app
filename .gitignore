# ---------------------------------------------------------------------------
# Kredensial & konfigurasi khusus deployment  (JANGAN pernah di-commit)
# ---------------------------------------------------------------------------
# Konfigurasi Firebase berisi API key dan project id milik masing-masing orang.
# Gunakan file *.example sebagai acuan, lalu isi dengan project Firebase Anda.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
.firebaserc
.firebase/

